{
  "type": "object",
  "properties": {
    "decision": {"type": "string", "enum": ["pick", "fork"]},
    "pick": {"type": ["integer", "null"], "description": "Index of the chosen option, from 0. On a fork, the recommendation."},
    "same_or_different": {"type": "string", "enum": ["same", "different", "not_applicable"]},
    "reason": {"type": "string"},
    "queries_for_owner": {"type": "array", "items": {"type": "string"}},
    "fork": {
      "type": "object",
      "properties": {
        "question": {"type": "string"},
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "author": {"type": "string"},
              "tradeoff": {"type": "string"},
              "case": {"type": "string"}
            }
          }
        }
      }
    },
    "say": {"type": "string"}
  }
}
