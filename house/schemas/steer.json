{
  "type": "object",
  "properties": {
    "changed": {
      "type": "array",
      "description": "What you altered in the reading or the bible, one plain line each; empty if nothing",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reading": {
      "type": "object",
      "properties": {
        "crux": {
          "type": "array",
          "description": "The one or two things a translation of this text stands or falls on.",
          "items": {
            "type": "object",
            "properties": {
              "point": {
                "type": "string",
                "minLength": 1
              },
              "why": {
                "type": "string",
                "minLength": 1
              },
              "for_the_english": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1,
          "maxItems": 3
        },
        "reading": {
          "type": "string",
          "description": "The reading in prose, crux first, about a page, for the translator.",
          "minLength": 1
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string"
              },
              "why_it_matters": {
                "type": "string"
              },
              "anchors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "voice_takes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 2,
          "maxItems": 3,
          "description": "Two or three voices the reading allows, the one you'd choose first: the house drafts in the first unless the editor picks another"
        }
      },
      "description": "The house's reading, with the note carried into it where the note touches it; otherwise exactly as it was."
    },
    "bible": {
      "type": "object",
      "properties": {
        "cast": {
          "type": "array",
          "description": "Every person the text refers to, minor and unnamed ones with a handle.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "c1, c2, ... in order of first appearance"
              },
              "handle": {
                "type": "string",
                "description": "How the house refers to them: a name, or 'the old man at the rice shop'"
              },
              "name_ja": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reading": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "romanised": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "forms": {
                "type": "array",
                "description": "Every form they're referred to or addressed by, and who uses it.",
                "items": {
                  "type": "object",
                  "properties": {
                    "form": {
                      "type": "string"
                    },
                    "used_by": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    }
                  }
                }
              },
              "gender": {
                "type": "string",
                "description": "female / male / not shown / deliberately open"
              },
              "gender_evidence": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "relationships": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "first_person": {
                "type": "string",
                "description": "Their first-person pronoun(s) and what each says about them, or 'none in the text'"
              },
              "register": {
                "type": "string"
              },
              "first_appearance": {
                "type": "string",
                "description": "Paragraph ID"
              }
            }
          }
        },
        "narration": {
          "type": "object",
          "properties": {
            "person": {
              "type": "string"
            },
            "narrator": {
              "type": "string"
            },
            "tense_habits": {
              "type": "string"
            },
            "english_tense": {
              "type": "string"
            },
            "frame": {
              "type": "string"
            },
            "timeline": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "motifs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "motif": {
                "type": "string"
              },
              "source_forms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "occurrences": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "why": {
                "type": "string"
              },
              "english": {
                "type": "string",
                "description": "How the English should carry it"
              }
            }
          }
        },
        "style_sheet": {
          "type": "object",
          "properties": {
            "register": {
              "type": "string"
            },
            "honorifics_and_names": {
              "type": "string"
            },
            "keep_in_japanese": {
              "type": "string"
            },
            "ruby_and_italics": {
              "type": "string"
            },
            "quotation": {
              "type": "string"
            },
            "author_voice": {
              "type": "string"
            },
            "annotation_density": {
              "type": "string"
            },
            "standing_rules": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Only rules the editor has set, each with its scope; empty until there are some. Your own guidance goes in the other fields, with its reason"
            }
          }
        },
        "hard_spots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "anchors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "kind": {
                "type": "string"
              },
              "why_hard": {
                "type": "string"
              }
            }
          }
        },
        "part_summaries": {
          "type": "array",
          "description": "Only when the book is in more than one part: one per part, in order; otherwise empty",
          "items": {
            "type": "object",
            "properties": {
              "starts": {
                "type": "string",
                "description": "The paragraph ID the part starts at"
              },
              "summary": {
                "type": "string",
                "description": "A few plain sentences: who appears, what happens, what is established or changes"
              }
            }
          }
        }
      },
      "description": "The story bible, with the note carried into it where the note touches it; otherwise exactly as it was."
    },
    "reply": {
      "type": "string",
      "minLength": 1,
      "description": "For the person who wrote the note: a few plain sentences on what changed, what didn't and why"
    },
    "question": {
      "type": [
        "string",
        "null"
      ],
      "description": "Only when the note can't be acted on without an answer: the one question; otherwise null"
    },
    "say": {
      "type": "string",
      "minLength": 1
    }
  }
}
