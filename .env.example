# Meta Model API key (https://dev.meta.ai). Without it, the house runs on FakeClient from fixtures/.
MODEL_API_KEY=
# Optional base URL override (default https://api.meta.ai/v1)
MODEL_API_BASE=
# Where the database, the response cache, audits and releases live (default: the repo's var/).
# On Railway, the volume's mount path: everything outside it is wiped on every deploy.
KEIKAKU_DATA_DIR=
# Spend caps in dollars, checked before every call (house/budget.py)
KEIKAKU_CAP_RUN=30
KEIKAKU_CAP_DAILY=30
KEIKAKU_CAP_TOTAL=100
# Calls one stage may have out at once, where they don't depend on each other (the readers, the checkpoint's voice takes); 1 runs them one by one
KEIKAKU_PARALLEL=4
# Kill switch: false closes the house (no live calls; replay only)
HOUSE_OPEN=true
# Comments: the editor's daily email goes through Resend (resend.com). Without a key, it goes to the server log.
# RESEND_API_KEY also sends password reset links; without it the reset page says reset mail isn't set up.
RESEND_API_KEY=
REPORT_EMAIL_TO=
# A sender on a domain verified in Resend; without one, Resend's test sender, which only delivers to the account's own address
REPORT_EMAIL_FROM=
# Salt for hashing commenters' cookies and addresses and invite tokens (any long random string; changing it voids every invite link)
# It also encrypts the Meta keys editors sign up with (house/accounts.py): changing it makes every stored key unreadable, so they have to add theirs again from the desk
KEIKAKU_SECRET=
# Comment limits (defaults shown)
COMMENTS_PER_HOUR=3
COMMENTS_PER_DAY=10
COMMENTS_SITE_DAILY=200
REPORTS_PER_HOUR=6
REPORTS_PER_DAY=20
# Reports from this many different addresses hide a comment; the daily email goes after this hour, UK time
REPORTS_TO_HIDE=2
DIGEST_HOUR=8
# Behind a proxy that appends the visitor's address to X-Forwarded-For (Railway does): true, so the rate limits
# count the visitor rather than the proxy. Leave it false (the default) when the site is reached directly, or anyone can fake an address.
KEIKAKU_TRUST_PROXY=false
# Where people write when they can't sign in: an email address shown on the reset page when reset mail (RESEND_API_KEY) isn't set up
KEIKAKU_CONTACT=
# The site's address, for the links keikaku invite prints and the daily email carries (default http://127.0.0.1:8000)
KEIKAKU_BASE_URL=
# Backup (litestream.yml): Litestream streams the database to S3-compatible object storage.
# Bucket, endpoint (e.g. https://<account>.r2.cloudflarestorage.com), region (often "auto"), and the bucket's keys.
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
